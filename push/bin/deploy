#!/usr/bin/env python3
"""Deploy the KC 311 push Worker to Cloudflare through the API (no wrangler).

Reads:
  ios/Config/civic-config.json   city key, city id, app version (as testflight.sh)
  ios/Config/Signing.xcconfig    team id and bundle id prefix
  APNS_KEY_PATH, APNS_KEY_ID     the APNs .p8 key (default: the newest AuthKey in
                                 ~/.appstoreconnect/private_keys with APNS_KEY_ID)
  ADMIN_TOKEN                    optional; enables POST /run (runs the cron pass now)
  CF_ACCOUNT_ID, CF_API_TOKEN    a token with Workers Scripts:Edit and Workers KV
                                 Storage:Edit, from the environment or push/.env

Run it again after the city rotates its key so the Worker gets the new one.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import urllib.request
from pathlib import Path

PUSH = Path(__file__).resolve().parent.parent
IOS = PUSH.parent / "ios"
NAME = os.environ.get("KC311_PUSH_WORKER", "kc311-push")


def env_file() -> None:
    f = PUSH / ".env"
    if f.exists():
        for line in f.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                os.environ.setdefault(k.strip().removeprefix("export "), v.strip().strip("'\""))


def xcconfig(key: str) -> str:
    for line in (IOS / "Config" / "Signing.xcconfig").read_text().splitlines():
        if line.split("=")[0].strip() == key:
            return line.split("=", 1)[1].strip()
    sys.exit(f"{key} missing from Signing.xcconfig")


def cf(method: str, path: str, body: bytes | None = None, ctype: str = "application/json") -> dict:
    url = f"https://api.cloudflare.com/client/v4/accounts/{os.environ['CF_ACCOUNT_ID']}{path}"
    req = urllib.request.Request(url, data=body, method=method,
                                 headers={"Authorization": f"Bearer {os.environ['CF_API_TOKEN']}", "Content-Type": ctype})
    with urllib.request.urlopen(req) as r:
        data = json.loads(r.read())
    if not data.get("success"):
        sys.exit(f"{method} {path}: {data.get('errors')}")
    return data


def kv_namespace() -> str:
    title = f"{NAME}-state"
    for ns in cf("GET", "/storage/kv/namespaces?per_page=100")["result"]:
        if ns["title"] == title:
            return ns["id"]
    return cf("POST", "/storage/kv/namespaces", json.dumps({"title": title}).encode())["result"]["id"]


def main() -> None:
    env_file()
    for k in ("CF_ACCOUNT_ID", "CF_API_TOKEN", "APNS_KEY_ID"):
        if not os.environ.get(k):
            sys.exit(f"set {k}")
    key_id = os.environ["APNS_KEY_ID"]
    key_path = Path(os.environ.get("APNS_KEY_PATH")
                    or Path.home() / ".appstoreconnect" / "private_keys" / f"AuthKey_{key_id}.p8")
    civic = json.loads((IOS / "Config" / "civic-config.json").read_text())
    plain = {
        "CITY_ID": civic["city_id"], "APP_VERSION": civic["app_version"],
        "BASE_URL": civic.get("base_url") or "https://api.mycivicapps.com/api/v3/",
        "APNS_TOPIC": f"{xcconfig('BUNDLE_ID_PREFIX')}.kc311", "APNS_TEAM_ID": xcconfig("DEVELOPMENT_TEAM"),
        "APNS_KEY_ID": key_id,
    }
    secret = {"CIVIC_KEY": civic["key"], "APNS_KEY": key_path.read_text(), "ADMIN_TOKEN": os.environ.get("ADMIN_TOKEN", "")}
    bindings = ([{"type": "kv_namespace", "name": "KV", "namespace_id": kv_namespace()}]
                + [{"type": "plain_text", "name": k, "text": str(v)} for k, v in plain.items()]
                + [{"type": "secret_text", "name": k, "text": v} for k, v in secret.items()])
    meta = {"main_module": "worker.js", "compatibility_date": "2026-09-01", "bindings": bindings}
    # curl builds the multipart body; the metadata goes over stdin so no secret lands on disk or argv.
    url = f"https://api.cloudflare.com/client/v4/accounts/{os.environ['CF_ACCOUNT_ID']}/workers/scripts/{NAME}"
    out = subprocess.run(
        ["curl", "-sS", "-X", "PUT", url, "-H", f"Authorization: Bearer {os.environ['CF_API_TOKEN']}",
         "-F", "metadata=@-;type=application/json", "-F", f"worker.js=@{PUSH / 'worker.js'};type=application/javascript+module"],
        input=json.dumps(meta), capture_output=True, text=True, check=True).stdout
    if not json.loads(out).get("success"):
        sys.exit(f"upload: {out}")
    cf("PUT", f"/workers/scripts/{NAME}/schedules", json.dumps([{"cron": "* * * * *"}]).encode())
    cf("POST", f"/workers/scripts/{NAME}/subdomain", json.dumps({"enabled": True}).encode())
    sub = cf("GET", "/workers/subdomain")["result"]["subdomain"]
    print(f"https://{NAME}.{sub}.workers.dev")


if __name__ == "__main__":
    main()
