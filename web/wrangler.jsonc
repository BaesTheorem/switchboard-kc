// Cloudflare Worker for the Switchboard KC web app. `npx wrangler deploy` from web/.
// Secrets (wrangler secret put NAME): ADMIN_TOKEN (the owner's token, for the
// owner tools), and optionally CIVIC_KEY (a first key; the app can also read
// it from the city's app), TURNSTILE_SECRET (the robot check on filing).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard-kc",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/cal/*"]
  },
  // One namespace holds the key, alert subscriptions, and caches.
  "kv_namespaces": [{ "binding": "KV", "id": "d549e5992ed34cbdb37725cca31fc9ab" }],
  // The daily report counts: one SQLite Durable Object (worker/ledger.js).
  "durable_objects": { "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }],
  // City meetings come from the Common Lot Worker (worker/open.js). Delete this
  // binding on a self-hosted server: it then reads Common Lot's public address.
  "services": [{ "binding": "COMMON_LOT", "service": "common-lot" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_NAME": "Switchboard KC",
    // open | off. The owner can change it at run time (Settings > Owner).
    "MODE": "open",
    // Reports one IP address can file a day through this server.
    "SUBMIT_DAILY": "10",
    "VAPID_SUBJECT": "https://github.com/BaesTheorem/switchboard-kc",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFi6_IY6KOTpnx6s"
  },
  "ratelimits": [
    { "name": "READS", "namespace_id": "3111", "simple": { "limit": 150, "period": 60 } },
    { "name": "WRITES", "namespace_id": "3112", "simple": { "limit": 4, "period": 60 } },
    { "name": "SLOW", "namespace_id": "3113", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
